# =============================================================================
# Polymarket AI Trading Agent - Environment Configuration Template
# Copy this file to .env and fill in your values. NEVER commit .env to git.
# =============================================================================

# -----------------------------------------------------------------------------
# POLYMARKET / WALLET (REQUIRED for trading)
# -----------------------------------------------------------------------------
# Your Polygon wallet private key (0x... format). This controls the funds.
# Recommended: Use a dedicated small wallet with only $10-20 USDC.
# For new users, prefer Signature Type 3 (POLY_1271 / deposit wallet) - see docs.
# The SDK will derive L2 API credentials from this.
POLYMARKET_PRIVATE_KEY=0xYOUR_POLYGON_PRIVATE_KEY_HERE

# Optional: Explicit funder / deposit wallet address if different from the signer
# (recommended for signature type 3). Leave empty to default to signer address.
# POLYMARKET_DEPOSIT_WALLET_ADDRESS=0x...

# -----------------------------------------------------------------------------
# LLM PROVIDER KEYS (AT LEAST ONE REQUIRED)
# Use the cheapest capable model possible (Grok Fast or GPT-4o-mini recommended).
# litellm will route based on your model name in config.
# -----------------------------------------------------------------------------
# xAI Grok (recommended for agentic performance + price)
XAI_API_KEY=sk-...

# OpenAI (GPT-4o-mini or successor mini models are excellent value)
OPENAI_API_KEY=sk-...

# Anthropic (Claude Haiku for high-quality but watch output token cost)
ANTHROPIC_API_KEY=sk-ant-...

# Optional other providers (Groq, Together, Fireworks, etc. via litellm)
# GROQ_API_KEY=...
# TOGETHER_API_KEY=...

# -----------------------------------------------------------------------------
# OPTIONAL: NEWS & RESEARCH APIs (FREE TIERS USUALLY SUFFICIENT)
# -----------------------------------------------------------------------------
# TheNewsAPI (generous free tier, good for real-time)
THENEWSAPI_API_KEY=...

# GNews
GNEWS_API_KEY=...

# NewsData.io
NEWSDATA_API_KEY=...

# Optional high-quality search (only enable if you want deeper research on key trades)
# TAVILY_API_KEY=...
# EXA_API_KEY=...

# -----------------------------------------------------------------------------
# AGENT BEHAVIOR & SAFETY (CRITICAL - READ CAREFULLY)
# -----------------------------------------------------------------------------
# Start with PAPER_TRADING=true. Only set false after extensive dry-run validation
# and when you fully understand the risk rules.
PAPER_TRADING=true

# Initial capital snapshot in USD (recorded on first init). The agent will
# fiercely protect this number. Do not manually edit after first run.
INITIAL_CAPITAL_USD=10.00

# Absolute maximum API / LLM spend allowed before the agent refuses new research
# (protects the $10 budget). The agent will become more conservative near the limit.
MAX_API_BUDGET_USD=10.00

# Minimum edge (in %) required after fees, slippage, and research cost.
# High value = very selective agent (recommended 8.0 - 12.0 for capital protection).
MIN_EDGE_PERCENT=9.5

# Maximum USD risk per individual trade (conservative starting point).
# The agent uses min(4% of current equity, this value) internally.
MAX_RISK_PER_TRADE_USD=0.75

# Polling interval in seconds for the main autonomous loop (300-1800 recommended).
POLL_INTERVAL_SECONDS=600

# Preferred LLM model for heavy reasoning (probability judgment).
# Examples: "grok-4-fast", "gpt-4o-mini", "claude-3-5-haiku-20241022"
REASONING_MODEL=grok-4-fast

# Cheaper/faster model for summarization and light research tasks.
FAST_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# DuckDB is strongly recommended (zero setup, excellent analytics).
# Use a simple relative path or absolute. The file will be created automatically.
DUCKDB_PATH=data/trader.duckdb

# Future: Set DB_BACKEND=postgres and provide connection string if desired.
# DB_BACKEND=duckdb
# POSTGRES_DSN=postgresql://user:pass@localhost:5432/polymarket_trader

# -----------------------------------------------------------------------------
# ADVANCED / DEBUG
# -----------------------------------------------------------------------------
# Set to "DEBUG" for verbose output during development.
LOG_LEVEL=INFO

# If true, the agent will ask for manual confirmation (y/N) before every real trade
# even when PAPER_TRADING=false. Highly recommended for first live runs.
REQUIRE_TRADE_CONFIRMATION=true

# Maximum number of LLM calls per loop iteration (hard safety cap).
MAX_LLM_CALLS_PER_CYCLE=6

# Blacklist categories (comma separated). Common noisy ones: sports, crypto (if too volatile for you)
MARKET_CATEGORY_BLACKLIST=["sports","entertainment"]

# -----------------------------------------------------------------------------
# MARKET INTELLIGENCE + MICRO (new in this iteration)
# -----------------------------------------------------------------------------
# After fetching active markets we persist the batch to DB, score with cheap news,
# and write scores back. Future runs skip markets with low prior news_score.
BATCH_NEWS_SCORING_ENABLED=true
NEWS_SCORE_SKIP_THRESHOLD=0.22
NEWS_SCORE_COOLDOWN_HOURS=36

# The ONLY place the agent is allowed to be less strict: tiny exploratory positions
# when research is weak. Max ~$0.30, max 1-2 open. Main capital protection rules still apply.
MICRO_EXPLORATORY_ENABLED=true
MIN_EDGE_MICRO_PERCENT=5.5
MIN_CONF_MICRO=0.40
MICRO_MAX_RISK_USD=0.30

# =============================================================================
# SETUP CHECKLIST (do these before first run)
# 1. Copy this to .env and fill real values.
# 2. Fund a Polygon wallet with ~$12-15 USDC (CEX withdraw on Polygon network is cheapest).
# 3. Run: uv run polymarket-trader init
# 4. Run extensively in dry-run mode first: uv run polymarket-trader run --dry-run
# 5. Review decisions in DB or via `status` command.
# 6. Only then consider PAPER_TRADING=false with tiny size.
# =============================================================================
