[Unit]
Description=Polymarket 5m/15m Crypto Trading Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USER
Group=YOUR_USER
WorkingDirectory=/home/YOUR_USER/polymarket-bot
ExecStart=/home/YOUR_USER/polymarket-bot/bot
Restart=always
RestartSec=8
EnvironmentFile=/home/YOUR_USER/polymarket-bot/.env
# Ensure CGO/DuckDB shared libs are found if needed
Environment=CONFIG_PATH=configs/config.yaml
StandardOutput=journal
StandardError=journal
# Hardening (optional; comment out if they break DuckDB/CGO)
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
