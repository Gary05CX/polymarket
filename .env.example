# Polymarket wallet (required for live trading; not needed for dry_run)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Optional: pre-derived L2 API credentials (bot will CreateOrDerive if empty)
CLOB_API_KEY=
CLOB_SECRET=
CLOB_PASSPHRASE=

# Wallet type: 0=EOA, 1=PolyProxy, 2=Safe, 3=POLY_1271 Deposit Wallet
SIGNATURE_TYPE=0

# Required for proxy / deposit wallets (funder address)
FUNDER=

# Optional overrides
CLOB_HOST=https://clob.polymarket.com
CHAIN_ID=137

# Optional alert webhook (POST JSON on circuit breaker / critical errors)
WEBHOOK_URL=

# Path override for config (default: configs/config.yaml)
# CONFIG_PATH=configs/config.yaml
