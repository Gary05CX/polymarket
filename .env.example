# ===== Config path =====
# CONFIG_PATH=configs/config.yaml
# Ubuntu long-run (paper bold = more trades for data):
# CONFIG_PATH=configs/config.ubuntu.yaml
# CONFIG_PATH=configs/config.ubuntu.paper-bold.yaml
# Later tighten:
# CONFIG_PATH=configs/config.ubuntu.strict.yaml

# ===== Database switch =====
# duckdb (default, good for local Windows/dev) | postgres (Ubuntu long-run)
DB_DRIVER=duckdb

# DuckDB file (when DB_DRIVER=duckdb)
DUCKDB_PATH=data/bot.duckdb

# PostgreSQL DSN (when DB_DRIVER=postgres)
# Create DB first: sudo -u postgres createuser -P polymarket ; createdb -O polymarket polymarket
# Then apply schema (optional — bot auto-applies init DDL on start):
#   psql "$DATABASE_URL" -f db/init_postgresql.sql
DATABASE_URL=postgres://polymarket:CHANGE_ME@127.0.0.1:5432/polymarket?sslmode=disable

# ===== Polymarket wallet (required for live trading; not needed for dry_run) =====
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Optional: pre-derived L2 API credentials (bot will CreateOrDerive if empty)
CLOB_API_KEY=
CLOB_SECRET=
CLOB_PASSPHRASE=

# Wallet type: 0=EOA, 1=PolyProxy, 2=Safe, 3=POLY_1271 Deposit Wallet
SIGNATURE_TYPE=0

# Required for proxy / deposit wallets (funder address)
FUNDER=

# Optional overrides
CLOB_HOST=https://clob.polymarket.com
CHAIN_ID=137
# DRY_RUN=true

# Optional alert webhook (POST JSON on circuit breaker / critical errors)
WEBHOOK_URL=
