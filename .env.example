# ===== Config path =====
# CONFIG_PATH=configs/config.yaml
# Ubuntu long-run:
# CONFIG_PATH=configs/config.ubuntu.yaml
# CONFIG_PATH=configs/config.ubuntu.half-tight.yaml
# CONFIG_PATH=configs/config.ubuntu.half-tight-size5.yaml  # ~$5 paper (still dry_run)
# CONFIG_PATH=configs/config.ubuntu.live-size2-3.yaml     # ~$2–3 + tight risk (~$10 bankroll)
# CONFIG_PATH=configs/config.ubuntu.paper-bold.yaml
# CONFIG_PATH=configs/config.ubuntu.strict.yaml
# Live steps: docs/LIVE-CHECKLIST.md

# ===== Database switch =====
# duckdb (default, good for local Windows/dev) | postgres (Ubuntu long-run)
DB_DRIVER=duckdb

# DuckDB file (when DB_DRIVER=duckdb)
DUCKDB_PATH=data/bot.duckdb

# PostgreSQL DSN (when DB_DRIVER=postgres)
# Create DB first: sudo -u postgres createuser -P polymarket ; createdb -O polymarket polymarket
# Then apply schema (optional — bot auto-applies init DDL on start):
#   psql "$DATABASE_URL" -f db/init_postgresql.sql
DATABASE_URL=postgres://polymarket:CHANGE_ME@127.0.0.1:5432/polymarket?sslmode=disable

# ===== Polymarket wallet (required for live; not needed for dry_run) =====
# See docs/LIVE-CHECKLIST.md — never commit real keys.
# PRIVATE_KEY = Export private key (Signer). FUNDER = address that holds USDC.
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Optional: pre-derived L2 API credentials (bot will CreateOrDerive if empty)
CLOB_API_KEY=
CLOB_SECRET=
CLOB_PASSPHRASE=

# Wallet type: 0=EOA, 1=PolyProxy (common for site/Magic wallets), 2=Safe, 3=POLY_1271
SIGNATURE_TYPE=0

# Required when signer ≠ portfolio (proxy). Do NOT use 0x0 / empty for proxy accounts.
FUNDER=

# Optional overrides
CLOB_HOST=https://clob.polymarket.com
CHAIN_ID=137
# Env overrides yaml clob.dry_run. Keep true until intentional live smoke.
DRY_RUN=true

# Optional alert webhook (POST JSON on circuit breaker / critical errors)
WEBHOOK_URL=
